library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity DEMUX_1to2 is
    Port (
        D   : in  STD_LOGIC;                 -- Entrada de datos
        SEL : in  STD_LOGIC; 
        Y   : out STD_LOGIC  -- Salidas
    );
end DEMUX_1to4;

architecture Behavioral of DEMUX_1to2 is
begin
    process(D, SEL)
    begin
        -- Inicializamos las salidas en '0'
        Y <= (others => '0');
        
        case SEL is
            when "0" => Y(0) <= D;
            when "1" => Y(1) <= D;
            when others => Y <= (others => '0');
        end case;
    end process;
end Behavioral;
