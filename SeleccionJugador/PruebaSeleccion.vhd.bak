LIBRARY ieee;
USE ieee.std_logic_1164.all; 

LIBRARY work;

ENTITY PruebaSeleccion IS 
	PORT
	(
		reset :  IN  STD_LOGIC;
		clock :  IN  STD_LOGIC;
		Enable :  IN  STD_LOGIC;
		CAMBIO :  IN  STD_LOGIC;
		in3 :  IN  STD_LOGIC;
		in2 :  IN  STD_LOGIC;
		in1 :  IN  STD_LOGIC;
		in0 :  IN  STD_LOGIC;
		Jugador :  OUT  STD_LOGIC;
		HabOBotor :  OUT  STD_LOGIC
	);
END PruebaSeleccion;

ARCHITECTURE bdf_type OF PruebaSeleccion IS 

COMPONENT moduloseleccionjugador
	PORT(reset : IN STD_LOGIC;
		 clock : IN STD_LOGIC;
		 Enable : IN STD_LOGIC;
		 CAMBIO : IN STD_LOGIC;
		 in3 : IN STD_LOGIC;
		 in2 : IN STD_LOGIC;
		 in1 : IN STD_LOGIC;
		 in0 : IN STD_LOGIC;
		 Jugador : OUT STD_LOGIC;
		 Hab/Botor : OUT STD_LOGIC
	);
END COMPONENT;



BEGIN 



b2v_inst : moduloseleccionjugador
PORT MAP(reset => reset,
		 clock => clock,
		 Enable => Enable,
		 CAMBIO => CAMBIO,
		 in3 => in3,
		 in2 => in2,
		 in1 => in1,
		 in0 => in0,
		 Jugador => Jugador,
		 Hab/Botor => HabOBotor);


END bdf_type;