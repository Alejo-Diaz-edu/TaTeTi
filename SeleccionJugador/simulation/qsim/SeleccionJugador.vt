// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "11/13/2025 15:21:24"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    PruebaSeleccion
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module PruebaSeleccion_vlg_sample_tst(
	clock,
	Enable,
	in0,
	in1,
	in2,
	in3,
	reset,
	sampler_tx
);
input  clock;
input  Enable;
input  in0;
input  in1;
input  in2;
input  in3;
input  reset;
output sampler_tx;

reg sample;
time current_time;
always @(clock or Enable or in0 or in1 or in2 or in3 or reset)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module PruebaSeleccion_vlg_check_tst (
	Hab,
	Jugador,
	sampler_rx
);
input  Hab;
input  Jugador;
input sampler_rx;

reg  Hab_expected;
reg  Jugador_expected;

reg  Hab_prev;
reg  Jugador_prev;

reg  Hab_expected_prev;
reg  Jugador_expected_prev;

reg  last_Hab_exp;
reg  last_Jugador_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:2] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 2'b1;
end

// update real /o prevs

always @(trigger)
begin
	Hab_prev = Hab;
	Jugador_prev = Jugador;
end

// update expected /o prevs

always @(trigger)
begin
	Hab_expected_prev = Hab_expected;
	Jugador_expected_prev = Jugador_expected;
end



// expected Hab
initial
begin
	Hab_expected = 1'bX;
end 

// expected Jugador
initial
begin
	Jugador_expected = 1'bX;
end 
// generate trigger
always @(Hab_expected or Hab or Jugador_expected or Jugador)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected Hab = %b | expected Jugador = %b | ",Hab_expected_prev,Jugador_expected_prev);
	$display("| real Hab = %b | real Jugador = %b | ",Hab_prev,Jugador_prev);
`endif
	if (
		( Hab_expected_prev !== 1'bx ) && ( Hab_prev !== Hab_expected_prev )
		&& ((Hab_expected_prev !== last_Hab_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Hab :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Hab_expected_prev);
		$display ("     Real value = %b", Hab_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Hab_exp = Hab_expected_prev;
	end
	if (
		( Jugador_expected_prev !== 1'bx ) && ( Jugador_prev !== Jugador_expected_prev )
		&& ((Jugador_expected_prev !== last_Jugador_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Jugador :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Jugador_expected_prev);
		$display ("     Real value = %b", Jugador_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Jugador_exp = Jugador_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module PruebaSeleccion_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clock;
reg Enable;
reg in0;
reg in1;
reg in2;
reg in3;
reg reset;
// wires                                               
wire Hab;
wire Jugador;

wire sampler;                             

// assign statements (if any)                          
PruebaSeleccion i1 (
// port map - connection between master ports and signals/registers   
	.clock(clock),
	.Enable(Enable),
	.Hab(Hab),
	.in0(in0),
	.in1(in1),
	.in2(in2),
	.in3(in3),
	.Jugador(Jugador),
	.reset(reset)
);

// clock
always
begin
	clock = 1'b0;
	clock = #5000 1'b1;
	#5000;
end 

// Enable
initial
begin
	Enable = 1'b0;
	Enable = #20000 1'b1;
	Enable = #60000 1'b0;
	Enable = #40000 1'b1;
	Enable = #60000 1'b0;
	Enable = #30000 1'b1;
	Enable = #70000 1'b0;
	Enable = #40000 1'b1;
	Enable = #60000 1'b0;
	Enable = #40000 1'b1;
	Enable = #60000 1'b0;
	Enable = #40000 1'b1;
	Enable = #60000 1'b0;
	Enable = #40000 1'b1;
	Enable = #60000 1'b0;
	Enable = #40000 1'b1;
	Enable = #60000 1'b0;
	Enable = #40000 1'b1;
	Enable = #150000 1'b0;
end 

// in0
initial
begin
	in0 = 1'b0;
	in0 = #200000 1'b1;
	in0 = #100000 1'b0;
	in0 = #200000 1'b1;
	in0 = #100000 1'b0;
	in0 = #100000 1'b1;
	in0 = #100000 1'b0;
end 

// in1
initial
begin
	in1 = 1'b0;
	in1 = #300000 1'b1;
	in1 = #100000 1'b0;
	in1 = #100000 1'b1;
	in1 = #200000 1'b0;
	in1 = #100000 1'b1;
end 

// in2
initial
begin
	in2 = 1'b1;
	in2 = #100000 1'b0;
	in2 = #200000 1'b1;
	in2 = #200000 1'b0;
	in2 = #100000 1'b1;
	in2 = #200000 1'b0;
end 

// in3
initial
begin
	in3 = 1'b0;
	in3 = #400000 1'b1;
	in3 = #300000 1'b0;
	in3 = #100000 1'b1;
end 

// reset
initial
begin
	reset = 1'b0;
end 

PruebaSeleccion_vlg_sample_tst tb_sample (
	.clock(clock),
	.Enable(Enable),
	.in0(in0),
	.in1(in1),
	.in2(in2),
	.in3(in3),
	.reset(reset),
	.sampler_tx(sampler)
);

PruebaSeleccion_vlg_check_tst tb_out(
	.Hab(Hab),
	.Jugador(Jugador),
	.sampler_rx(sampler)
);
endmodule

