// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "11/09/2025 16:19:19"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    Almace1
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module Almace1_vlg_sample_tst(
	CLK,
	IN_1,
	IN_2,
	RESET_1,
	RESET_2,
	sampler_tx
);
input  CLK;
input  IN_1;
input  IN_2;
input  RESET_1;
input  RESET_2;
output sampler_tx;

reg sample;
time current_time;
always @(CLK or IN_1 or IN_2 or RESET_1 or RESET_2)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module Almace1_vlg_check_tst (
	JUGADOR_1,
	JUGADOR_2_IA,
	ocupado,
	sampler_rx
);
input  JUGADOR_1;
input  JUGADOR_2_IA;
input  ocupado;
input sampler_rx;

reg  JUGADOR_1_expected;
reg  JUGADOR_2_IA_expected;
reg  ocupado_expected;

reg  JUGADOR_1_prev;
reg  JUGADOR_2_IA_prev;
reg  ocupado_prev;

reg  JUGADOR_1_expected_prev;
reg  JUGADOR_2_IA_expected_prev;
reg  ocupado_expected_prev;

reg  last_JUGADOR_1_exp;
reg  last_JUGADOR_2_IA_exp;
reg  last_ocupado_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:3] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 3'b1;
end

// update real /o prevs

always @(trigger)
begin
	JUGADOR_1_prev = JUGADOR_1;
	JUGADOR_2_IA_prev = JUGADOR_2_IA;
	ocupado_prev = ocupado;
end

// update expected /o prevs

always @(trigger)
begin
	JUGADOR_1_expected_prev = JUGADOR_1_expected;
	JUGADOR_2_IA_expected_prev = JUGADOR_2_IA_expected;
	ocupado_expected_prev = ocupado_expected;
end



// expected JUGADOR_1
initial
begin
	JUGADOR_1_expected = 1'bX;
end 

// expected JUGADOR_2_IA
initial
begin
	JUGADOR_2_IA_expected = 1'bX;
end 

// expected ocupado
initial
begin
	ocupado_expected = 1'bX;
end 
// generate trigger
always @(JUGADOR_1_expected or JUGADOR_1 or JUGADOR_2_IA_expected or JUGADOR_2_IA or ocupado_expected or ocupado)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected JUGADOR_1 = %b | expected JUGADOR_2_IA = %b | expected ocupado = %b | ",JUGADOR_1_expected_prev,JUGADOR_2_IA_expected_prev,ocupado_expected_prev);
	$display("| real JUGADOR_1 = %b | real JUGADOR_2_IA = %b | real ocupado = %b | ",JUGADOR_1_prev,JUGADOR_2_IA_prev,ocupado_prev);
`endif
	if (
		( JUGADOR_1_expected_prev !== 1'bx ) && ( JUGADOR_1_prev !== JUGADOR_1_expected_prev )
		&& ((JUGADOR_1_expected_prev !== last_JUGADOR_1_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port JUGADOR_1 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", JUGADOR_1_expected_prev);
		$display ("     Real value = %b", JUGADOR_1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_JUGADOR_1_exp = JUGADOR_1_expected_prev;
	end
	if (
		( JUGADOR_2_IA_expected_prev !== 1'bx ) && ( JUGADOR_2_IA_prev !== JUGADOR_2_IA_expected_prev )
		&& ((JUGADOR_2_IA_expected_prev !== last_JUGADOR_2_IA_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port JUGADOR_2_IA :: @time = %t",  $realtime);
		$display ("     Expected value = %b", JUGADOR_2_IA_expected_prev);
		$display ("     Real value = %b", JUGADOR_2_IA_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_JUGADOR_2_IA_exp = JUGADOR_2_IA_expected_prev;
	end
	if (
		( ocupado_expected_prev !== 1'bx ) && ( ocupado_prev !== ocupado_expected_prev )
		&& ((ocupado_expected_prev !== last_ocupado_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ocupado :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ocupado_expected_prev);
		$display ("     Real value = %b", ocupado_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_ocupado_exp = ocupado_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module Almace1_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
reg IN_1;
reg IN_2;
reg RESET_1;
reg RESET_2;
// wires                                               
wire JUGADOR_1;
wire JUGADOR_2_IA;
wire ocupado;

wire sampler;                             

// assign statements (if any)                          
Almace1 i1 (
// port map - connection between master ports and signals/registers   
	.CLK(CLK),
	.IN_1(IN_1),
	.IN_2(IN_2),
	.JUGADOR_1(JUGADOR_1),
	.JUGADOR_2_IA(JUGADOR_2_IA),
	.ocupado(ocupado),
	.RESET_1(RESET_1),
	.RESET_2(RESET_2)
);

// CLK
always
begin
	CLK = 1'b0;
	CLK = #20000 1'b1;
	#20000;
end 

// IN_1
initial
begin
	IN_1 = 1'b1;
	IN_1 = #50000 1'b0;
	IN_1 = #230000 1'b1;
	IN_1 = #110000 1'b0;
end 

// IN_2
initial
begin
	IN_2 = 1'b0;
	IN_2 = #130000 1'b1;
	IN_2 = #130000 1'b0;
end 

// RESET_1
initial
begin
	RESET_1 = 1'b0;
end 

// RESET_2
initial
begin
	RESET_2 = 1'b0;
end 

Almace1_vlg_sample_tst tb_sample (
	.CLK(CLK),
	.IN_1(IN_1),
	.IN_2(IN_2),
	.RESET_1(RESET_1),
	.RESET_2(RESET_2),
	.sampler_tx(sampler)
);

Almace1_vlg_check_tst tb_out(
	.JUGADOR_1(JUGADOR_1),
	.JUGADOR_2_IA(JUGADOR_2_IA),
	.ocupado(ocupado),
	.sampler_rx(sampler)
);
endmodule

