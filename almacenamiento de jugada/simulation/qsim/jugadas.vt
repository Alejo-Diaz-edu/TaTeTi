	$display("| real Jugada_valida = %b | real Led1 = %b | real Led2 = %b | real Led3 = %b | real Led4 = %b | real Led5 = %b | real Led6 = %b | real Led7 = %b | real Led8 = %b | real Led9 = %b | real Reset_de_ocupado = %b | ",Jugada_valida_prev,Led1_prev,Led2_prev,Led3_prev,Led4_prev,Led5_prev,Led6_prev,Led7_prev,Led8_prev,Led9_prev,Reset_de_ocupado_prev);
