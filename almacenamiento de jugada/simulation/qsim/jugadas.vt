initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module Bloque_final_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
reg [3:0] data;
reg Habilitado;
reg Jugador;
reg RESET_GENERAL;
// wires                                               
wire Empate;
wire Fin;
wire Ganador_jugador_dos;
wire Ganador_jugador_uno;
wire Habilitada_ocupado;
wire pin_name2;
wire pin_name3;
wire pin_name4;
wire pin_name5;
wire pin_name6;
wire pin_name8;
wire pin_name9;
wire pin_name10;
wire pin_name11;
wire pin_name12;
wire pin_name13;
wire pin_name14;
wire pin_name15;
wire pin_name16;
wire pin_name17;
wire pin_name18;
wire pin_name19;
wire pin_name20;

wire sampler;                             

// assign statements (if any)                          
Bloque_final i1 (
// port map - connection between master ports and signals/registers   
	.CLK(CLK),
	.data(data),
	.Empate(Empate),
	.Fin(Fin),
	.Ganador_jugador_dos(Ganador_jugador_dos),
	.Ganador_jugador_uno(Ganador_jugador_uno),
	.Habilitada_ocupado(Habilitada_ocupado),
	.Habilitado(Habilitado),
	.Jugador(Jugador),
	.pin_name2(pin_name2),
	.pin_name3(pin_name3),
	.pin_name4(pin_name4),
	.pin_name5(pin_name5),
	.pin_name6(pin_name6),
	.pin_name8(pin_name8),
	.pin_name9(pin_name9),
	.pin_name10(pin_name10),
	.pin_name11(pin_name11),
	.pin_name12(pin_name12),
	.pin_name13(pin_name13),
	.pin_name14(pin_name14),
	.pin_name15(pin_name15),
	.pin_name16(pin_name16),
	.pin_name17(pin_name17),
	.pin_name18(pin_name18),
	.pin_name19(pin_name19),
	.pin_name20(pin_name20),
	.RESET_GENERAL(RESET_GENERAL)
);

// CLK
initial
begin
	CLK = 1'b0;
end 
// data[ 3 ]
initial
begin
	data[3] = 1'b0;
end 
// data[ 2 ]
initial
begin
	data[2] = 1'b0;
end 
// data[ 1 ]
initial
begin
	data[1] = 1'b0;
end 
// data[ 0 ]
initial
begin
	data[0] = 1'b0;
end 

// Habilitado
initial
begin
	Habilitado = 1'b0;
end 

// Jugador
initial
begin
	Jugador = 1'b0;
end 

// RESET_GENERAL
initial
begin
	RESET_GENERAL = 1'b0;
end 

Bloque_final_vlg_sample_tst tb_sample (
	.CLK(CLK),
	.data(data),
	.Habilitado(Habilitado),
	.Jugador(Jugador),
	.RESET_GENERAL(RESET_GENERAL),
	.sampler_tx(sampler)
);

Bloque_final_vlg_check_tst tb_out(
	.Empate(Empate),
	.Fin(Fin),
	.Ganador_jugador_dos(Ganador_jugador_dos),
	.Ganador_jugador_uno(Ganador_jugador_uno),
	.Habilitada_ocupado(Habilitada_ocupado),
	.pin_name2(pin_name2),
	.pin_name3(pin_name3),
	.pin_name4(pin_name4),
	.pin_name5(pin_name5),
	.pin_name6(pin_name6),
	.pin_name8(pin_name8),
	.pin_name9(pin_name9),
	.pin_name10(pin_name10),
	.pin_name11(pin_name11),
	.pin_name12(pin_name12),
	.pin_name13(pin_name13),
	.pin_name14(pin_name14),
	.pin_name15(pin_name15),
	.pin_name16(pin_name16),
	.pin_name17(pin_name17),
	.pin_name18(pin_name18),
	.pin_name19(pin_name19),
	.pin_name20(pin_name20),
	.sampler_rx(sampler)
);
endmodule

