`timescale 1 ps/ 1 ps
module Bloque_final_vlg_sample_tst(
	CLK,
	data,
	Habilitado,
	Jugador,
	RESET_GENERAL,
	sampler_tx
);
input  CLK;
input [3:0] data;
input  Habilitado;
input  Jugador;
input  RESET_GENERAL;
output sampler_tx;

reg sample;
time current_time;
always @(CLK or data or Habilitado or Jugador or RESET_GENERAL)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

