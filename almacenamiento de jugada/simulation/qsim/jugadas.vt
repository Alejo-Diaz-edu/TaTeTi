	Jugador2_led4,
	Jugador2_led5,
	Jugador2_led6,
	Jugador2_led7,
	Jugador2_led8,
	Jugador2_led9,
	ocupado1,
	ocupado2,
	ocupado3,
	ocupado4,
	ocupado5,
	ocupado6,
	ocupado7,
	ocupado8,
	ocupado9,
	reset_jugador,
	reset_sig_jugador,
	sampler_tx
);
input  Jugador1_led1;
input  Jugador1_led2;
input  Jugador1_led3;
input  Jugador1_led4;
input  Jugador1_led5;
input  Jugador1_led6;
