	if (
		( P2_LEDS_expected_prev[7] !== 1'bx ) && ( P2_LEDS_prev[7] !== P2_LEDS_expected_prev[7] )
		&& ((P2_LEDS_expected_prev[7] !== last_P2_LEDS_exp[7]) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port P2_LEDS[7] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", P2_LEDS_expected_prev);
		$display ("     Real value = %b", P2_LEDS_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_P2_LEDS_exp[7] = P2_LEDS_expected_prev[7];
	end
	if (
		( P2_LEDS_expected_prev[8] !== 1'bx ) && ( P2_LEDS_prev[8] !== P2_LEDS_expected_prev[8] )
		&& ((P2_LEDS_expected_prev[8] !== last_P2_LEDS_exp[8]) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port P2_LEDS[8] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", P2_LEDS_expected_prev);
		$display ("     Real value = %b", P2_LEDS_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_P2_LEDS_exp[8] = P2_LEDS_expected_prev[8];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module Bloque_final_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
reg [3:0] data;
reg Habilitado;
reg Jugador;
reg RESET_GENERAL;
// wires                                               
wire Empate;
wire Fin;
wire Ganador_jugador_1;
wire Ganador_jugador_2;
wire Habilitada_ocupado;
wire [0:8] P1_LEDS;
wire [0:8] P2_LEDS;

wire sampler;                             

// assign statements (if any)                          
Bloque_final i1 (
// port map - connection between master ports and signals/registers   
	.CLK(CLK),
	.data(data),
	.Empate(Empate),
	.Fin(Fin),
	.Ganador_jugador_1(Ganador_jugador_1),
	.Ganador_jugador_2(Ganador_jugador_2),
	.Habilitada_ocupado(Habilitada_ocupado),
	.Habilitado(Habilitado),
	.Jugador(Jugador),
	.P1_LEDS(P1_LEDS),
	.P2_LEDS(P2_LEDS),
	.RESET_GENERAL(RESET_GENERAL)
);

// RESET_GENERAL
initial
begin
	RESET_GENERAL = 1'b0;
	RESET_GENERAL = #660000 1'b1;
	RESET_GENERAL = #120000 1'b0;
end 

// Jugador
initial
begin
	Jugador = 1'b0;
	Jugador = #120000 1'b1;
	Jugador = #40000 1'b0;
	Jugador = #120000 1'b1;
	Jugador = #40000 1'b0;
	Jugador = #120000 1'b1;
	Jugador = #40000 1'b0;
	Jugador = #120000 1'b1;
	Jugador = #40000 1'b0;
	Jugador = #120000 1'b1;
	Jugador = #40000 1'b0;
end 

// CLK
always
begin
	CLK = 1'b0;
	CLK = #10000 1'b1;
	#10000;
end 

// Habilitado
initial
begin
	repeat(12)
	begin
		Habilitado = 1'b0;
		Habilitado = #40000 1'b1;
		# 40000;
	end
	Habilitado = 1'b0;
end 
// data[ 3 ]
initial
begin
	data[3] = 1'b0;
	data[3] = #20000 1'b1;
	data[3] = #60000 1'b0;
	data[3] = #40000 1'b1;
	data[3] = #40000 1'b0;
	data[3] = #40000 1'b1;
	data[3] = #40000 1'b0;
	data[3] = #120000 1'b1;
	data[3] = #40000 1'b0;
	data[3] = #120000 1'b1;
	data[3] = #40000 1'b0;
	data[3] = #280000 1'b1;
	data[3] = #40000 1'b0;
	data[3] = #40000 1'b1;
	data[3] = #40000 1'b0;
end 
// data[ 2 ]
initial
begin
	data[2] = 1'b0;
	data[2] = #120000 1'b1;
	data[2] = #40000 1'b0;
	data[2] = #40000 1'b1;
	data[2] = #40000 1'b0;
	data[2] = #40000 1'b1;
	data[2] = #40000 1'b0;
	data[2] = #40000 1'b1;
	data[2] = #40000 1'b0;
	data[2] = #40000 1'b1;
	data[2] = #40000 1'b0;
	data[2] = #120000 1'b1;
	data[2] = #40000 1'b0;
end 
// data[ 1 ]
initial
begin
	data[1] = 1'b0;
	data[1] = #20000 1'b1;
	data[1] = #60000 1'b0;
	data[1] = #120000 1'b1;
	data[1] = #40000 1'b0;
	data[1] = #40000 1'b1;
	data[1] = #40000 1'b0;
	data[1] = #40000 1'b1;
	data[1] = #40000 1'b0;
	data[1] = #200000 1'b1;
	data[1] = #40000 1'b0;
	data[1] = #200000 1'b1;
	data[1] = #40000 1'b0;
	data[1] = #40000 1'b1;
	data[1] = #40000 1'b0;
end 
// data[ 0 ]
initial
begin
	data[0] = 1'b0;
	data[0] = #120000 1'b1;
	data[0] = #40000 1'b0;
	data[0] = #200000 1'b1;
	data[0] = #40000 1'b0;
	data[0] = #40000 1'b1;
	data[0] = #40000 1'b0;
	data[0] = #40000 1'b1;
	data[0] = #40000 1'b0;
	data[0] = #40000 1'b1;
	data[0] = #40000 1'b0;
end 

Bloque_final_vlg_sample_tst tb_sample (
	.CLK(CLK),
	.data(data),
	.Habilitado(Habilitado),
	.Jugador(Jugador),
	.RESET_GENERAL(RESET_GENERAL),
	.sampler_tx(sampler)
);

Bloque_final_vlg_check_tst tb_out(
	.Empate(Empate),
	.Fin(Fin),
	.Ganador_jugador_1(Ganador_jugador_1),
	.Ganador_jugador_2(Ganador_jugador_2),
	.Habilitada_ocupado(Habilitada_ocupado),
	.P1_LEDS(P1_LEDS),
	.P2_LEDS(P2_LEDS),
	.sampler_rx(sampler)
);
endmodule

