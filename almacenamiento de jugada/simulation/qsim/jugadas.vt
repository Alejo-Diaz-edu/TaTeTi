input  Jugador2_led5;
input  Jugador2_led6;
input  Jugador2_led7;
input  Jugador2_led8;
input  Jugador2_led9;
input  ocupado1;
input  ocupado2;
input  ocupado3;
input  ocupado4;
input  ocupado5;
input  ocupado6;
input  ocupado7;
input  ocupado8;
input  ocupado9;
input  reset_jugador;
input  reset_sig_jugador;
output sampler_tx;

reg sample;
time current_time;
always @(Jugador1_led1 or Jugador1_led2 or Jugador1_led3 or Jugador1_led4 or Jugador1_led5 or Jugador1_led6 or Jugador1_led7 or Jugador1_led8 or Jugador1_led9 or Jugador2_led1 or Jugador2_led2 or Jugador2_led3 or Jugador2_led4 or Jugador2_led5 or Jugador2_led6 or Jugador2_led7 or Jugador2_led8 or Jugador2_led9 or ocupado1 or ocupado2 or ocupado3 or ocupado4 or ocupado5 or ocupado6 or ocupado7 or ocupado8 or ocupado9 or reset_jugador or reset_sig_jugador)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

